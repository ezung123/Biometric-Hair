# ══════════════════════════════════════════════════════════════════════════════
# BIOMETRIC HAIR ARCH (φ 1.618) — ENVIRONMENT CONFIGURATION
# ══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env:
#   cp .env.example .env
#
# IMPORTANT: Never commit the actual .env file with live secrets to git.
# All API keys are loaded server-side by the local proxy (server/proxy.ts)
# and NEVER leaked into the client web bundle.
# ══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# 1. META MUSE SPARK OPEN (via Baseten Hackathon Grant) — REQUIRED FOR LIVE AI
# ─────────────────────────────────────────────────────────────────────────────
# Hackathon participants receive $100 in credits for Meta Muse Spark Open.
# Model: meta-models/muse-spark-open-1026
# Used for: Neoclassical Cephalometric Prescriptions, Salon Concierge Chat,
#           and Technical Multilingual Barber Translation (ES, ZH, FR).
BASETEN_API_KEY=your_baseten_api_key_here
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL_ID=meta-models/muse-spark-open-1026

# ─────────────────────────────────────────────────────────────────────────────
# 2. SERVER PROXY CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────
PROXY_PORT=3001
APP_TOKEN=biometric-hair-token-v1

# ─────────────────────────────────────────────────────────────────────────────
# 3. OPTIONAL META MODEL PROVIDERS
# ─────────────────────────────────────────────────────────────────────────────
# Optional: OpenRouter key if accessing meta/muse-image diffusion endpoint
OPENROUTER_API_KEY=

# Optional: Meta Model API direct access key
META_MODEL_API_KEY=

# Optional: Fireworks AI endpoint key
FIREWORKS_API_KEY=
